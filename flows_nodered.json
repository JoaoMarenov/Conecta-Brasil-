  {
    "id": "v3_fn_valida",
    "type": "function",
    "z": "v3_tab_jab",
    "name": "Valida e distribui",
    "func": "let d = msg.payload;\nif (typeof d === 'string') {\n    try { d = JSON.parse(d); } catch (e) { node.warn('JSON invalido: ' + msg.payload); return null; }\n}\nif (!d || typeof d.activations_pm !== 'number' || !d.status) {\n    node.warn('Payload invalido: ' + JSON.stringify(d));\n    return null;\n}\nconst prev = flow.get('prev_status');\nflow.set('prev_status', d.status);\nconst alerta = (d.status === 'ALTA' && prev !== 'ALTA')\n    ? { topic: 'ALERTA - Fluxo ALTO', payload: d.activations_pm + ' ativações em 5 min · CONECTA BRASIL' }\n    : null;\nreturn [\n    { topic: 'telemetry', payload: d },\n    { topic: 'act/min', payload: d.activations_pm },\n    alerta\n];",
    "outputs": 3,
    "timeout": 0,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 530,
    "y": 120,
    "wires": [
